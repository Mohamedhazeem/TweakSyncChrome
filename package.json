{
  "name": "tweaksync",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production tsc && vite build --sourcemap false",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:chrome": "vite build --sourcemap false --outDir dist/chrome && node scripts/build-manifest.mjs chrome",
    "build:edge": "vite build --sourcemap false --outDir dist/edge && node scripts/build-manifest.mjs edge",
    "build:firefox": "vite build --sourcemap false --outDir dist/firefox && node scripts/build-manifest.mjs firefox",
    "build:all": "vite build --sourcemap false --outDir dist/chrome && node scripts/build-manifest.mjs chrome && vite build --sourcemap false --outDir dist/edge && node scripts/build-manifest.mjs edge && vite build --sourcemap false --outDir dist/firefox && node scripts/build-manifest.mjs firefox",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && node scripts/lint-borders.mjs",
    "preview": "cross-env NODE_ENV=production vite preview",
    "watch": "cross-env NODE_ENV=development vite build --watch"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@types/webextension-polyfill": "^0.12.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.6",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-inspect": "^12.0.2",
    "vitest": "^4.1.10"
  }
}
